# Copy this file to .env
# Put NVIDIA keys here. Do not commit .env.
# Harvested option names: LiteLLM NVIDIA_NIM_API_KEY + quantum-free-router nvidia-nim.

NVIDIA_NIM_API_KEY=
NVIDIA_NIM_API_KEY_2=
NVIDIA_NIM_API_KEY_3=

# LiteLLM / quantum-free-router harvested base.
NVIDIA_NIM_API_BASE=https://integrate.api.nvidia.com/v1

# Default from quantum-free-router nvidia-nim catalog (fast local-dev pick).
ALTRON_MODEL=nvidia/nemotron-3-super-120b-a12b
ALTRON_FALLBACK_MODEL=meta/llama-3.1-70b-instruct

ALTRON_HOST=127.0.0.1
ALTRON_PORT=8088
ALTRON_DATA_DIR=./data

# Phase 4 — local Think fallback (pydantic-ai OllamaProvider harvest).
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.2:1b

# Browser agent 2.0 — visible Chrome by default. Set true for headless.
ALTRON_BROWSER_HEADLESS=false
# Optional comma allowlist; empty uses built-in safe defaults (google, github, wikipedia…)
ALTRON_BROWSER_ALLOWLIST=

# Optional LiveKit cloud face. Mic in the UI works without these.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Phase 5/6 organs
QDRANT_URL=http://127.0.0.1:6333
E2B_API_KEY=
N8N_WEBHOOK_URL=
N8N_BASE_URL=http://127.0.0.1:5678
COMFYUI_URL=http://127.0.0.1:8188
